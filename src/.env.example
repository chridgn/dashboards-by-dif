# PostgreSQL
POSTGRES_USER=dif
POSTGRES_PASSWORD=your_postgres_password_here
AIRFLOW_DB=airflow
DASHBOARD_DB=dashboard

# Airflow
AIRFLOW_UID=50000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=your_secret_key_here

AIRFLOW_WWW_USER=admin
AIRFLOW_WWW_PASSWORD=admin
AIRFLOW_WWW_EMAIL=your@email.com

# Domain (your EC2 domain)
DOMAIN=your.domain.here

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password_here

# GitHub token (used for EC2 deploy pull)
GH_TOKEN=your_github_token_here

# API Keys
BLS_API_KEY=your_bls_api_key_here
EIA_API_KEY=your_eia_api_key_here
FRED_API_KEY=your_fred_api_key_here