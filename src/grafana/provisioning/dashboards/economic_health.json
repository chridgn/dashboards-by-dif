    {
      "id": 1,
      "title": "Overall Inflation (CPI-U)",
      "description": "The CPI-U tracks how much a standard basket of goods and services costs over time for urban consumers - roughly 93% of the U.S. population. The index is set to 100 for the 1982-84 baseline, so a value of 314 today means that basket costs 3.14× what it did 40 years ago. When this line rises steeply, your dollar buys less of everything. When it flattens, prices are stabilizing. This is the single broadest measure of inflation affecting your daily life.",
      "type": "timeseries",
      "pluginVersion": "13.0.2",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "dashboard_db" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "showValues": false,
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 80 }]
          },
          "unit": "short",
          "displayName": "CPI-U"
        }
      },
      "options": {
        "annotations": { "clustering": -1, "multiLane": false },
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false },
